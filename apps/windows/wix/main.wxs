<?xml version='1.0' encoding='utf-8'?>
<!--
  Bộ cài MSI cho Lịch và Văn hóa Việt (WiX Toolset 3.14, dựng bằng cargo-wix 0.3.9).
  Cài theo người dùng (per-user, không cần quyền quản trị) vào %LOCALAPPDATA%\Programs.
  Không thêm vào PATH. Sổ đăng ký: chỉ khóa gỡ cài đặt của MSI và HKCU\Software\Clevix\LichVanHoaViet
  (giá trị đánh dấu KeyPath mà MSI cài theo người dùng bắt buộc phải có; xóa khi gỡ).
  Ghi chú: bảng MSI dùng mã trang 1252 nên tên hiển thị trong MSI viết không dấu
  ("Lich va Van hoa Viet") để tránh lỗi mã trang khi dựng;
  tên trong ứng dụng vẫn có dấu.
  GUID thành phần cố định (không dùng '*'): thành phần có KeyPath là giá trị sổ đăng ký thì WiX không
  tự sinh GUID (lỗi CNDL0230). Không đổi các GUID này giữa các phiên bản.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define Win64 = "yes" ?>
<?else ?>
    <?define Win64 = "no" ?>
<?endif ?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Lich va Van hoa Viet'
        UpgradeCode='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D01'
        Manufacturer='Clevix LLC'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Lich va Van hoa Viet - lich am duong Viet Nam (Clevix Lab)'
            Manufacturer='Clevix LLC'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            InstallPrivileges='limited'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='Da co phien ban moi hon. Hay go phien ban do truoc.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Lich va Van hoa Viet'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='ProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='LichVanHoaViet'>
                        <Component Id='MainExe' Guid='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D10' Win64='$(var.Win64)'>
                            <File Id='LichVietExe' Name='LichViet.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\LichViet.exe'/>
                            <RegistryValue Root='HKCU' Key='Software\Clevix\LichVanHoaViet' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
                            <RemoveFolder Id='RemoveAppFolder' On='uninstall'/>
                            <RemoveFolder Id='RemoveProgramsFolder' Directory='ProgramsFolder' On='uninstall'/>
                        </Component>
                        <Component Id='FontLicense' Guid='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D11' Win64='$(var.Win64)'>
                            <File Id='OflTxt' Name='OFL.txt' DiskId='1' Source='ui\fonts\OFL.txt'/>
                            <RegistryValue Root='HKCU' Key='Software\Clevix\LichVanHoaViet' Name='ofl' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Component Id='StartMenuShortcut' Guid='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D12'>
                    <!-- AppUserModelID trên lối tắt: ứng dụng chưa đóng gói (MSI, không MSIX) cần định danh này để Windows
                         nhận thông báo đặt lịch (02 §7.5, R-WIN-1). Phải trùng platform::AUMID trong src/platform.rs. -->
                    <Shortcut Id='AppShortcut' Name='Lich va Van hoa Viet' Target='[APPLICATIONFOLDER]LichViet.exe' WorkingDirectory='APPLICATIONFOLDER' Icon='ProductICO'>
                        <ShortcutProperty Key='System.AppUserModel.ID' Value='ClevixLab.LichVanHoaViet'/>
                    </Shortcut>
                    <RegistryValue Root='HKCU' Key='Software\Clevix\LichVanHoaViet' Name='shortcut' Type='integer' Value='1' KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature Id='Main' Title='Lich va Van hoa Viet' Level='1' Absent='disallow'>
            <ComponentRef Id='MainExe'/>
            <ComponentRef Id='FontLicense'/>
            <ComponentRef Id='StartMenuShortcut'/>
        </Feature>

        <Icon Id='ProductICO' SourceFile='assets\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>
        <Property Id='ARPURLINFOABOUT' Value='https://clevix.vn'/>
        <Property Id='ARPNOMODIFY' Value='1'/>
    </Product>
</Wix>

<?xml version='1.0' encoding='utf-8'?>
<!--
  Bộ cài MSI cho Lịch và Văn hóa Việt (WiX Toolset 3.14, dựng bằng cargo-wix 0.3.9).
  Cài theo người dùng (per-user, không cần quyền quản trị) vào %LOCALAPPDATA%\Programs.
  Không thêm vào PATH. Sổ đăng ký: chỉ khóa gỡ cài đặt của MSI và HKCU\Software\Clevix\LichVanHoaViet
  (giá trị đánh dấu KeyPath mà MSI cài theo người dùng bắt buộc phải có; xóa khi gỡ).
  Ghi chú: bảng MSI dùng mã trang 1252 nên tên hiển thị trong MSI viết không dấu
  ("Lich va Van hoa Viet") để tránh lỗi mã trang khi dựng;
  tên trong ứng dụng vẫn có dấu.
  GUID thành phần cố định (không dùng '*'): thành phần có KeyPath là giá trị sổ đăng ký thì WiX không
  tự sinh GUID (lỗi CNDL0230). Không đổi các GUID này giữa các phiên bản.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define Win64 = "yes" ?>
<?else ?>
    <?define Win64 = "no" ?>
<?endif ?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Lich va Van hoa Viet'
        UpgradeCode='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D01'
        Manufacturer='Clevix LLC'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Lich va Van hoa Viet - lich am duong Viet Nam (Clevix Lab)'
            Manufacturer='Clevix LLC'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            InstallPrivileges='limited'
            SummaryCodepage='1252'/>

        <!-- Nâng cấp lớn (R14, 04 Bổ sung B5): gỡ bản cũ rồi cài bản mới; cùng số phiên bản cũng tính là nâng cấp
             (AllowSameVersionUpgrades) để không bao giờ có hai bản cài song song.
             DỮ LIỆU KHÔNG THUỘC BỘ CÀI: sổ Người thân ở %LOCALAPPDATA%\ClevixLab\LichVanHoaViet và tệp "Để sau" ở
             %LOCALAPPDATA%\Clevix\LichVanHoaViet do ứng dụng tự tạo, không có thành phần MSI nào trỏ tới, nên cài đè,
             nâng cấp hay gỡ cài đặt đều không xóa. Không dùng RemoveFile/RemoveFolderEx/util:RemoveFolderEx ngoài thư
             mục chương trình. CI kiểm điều này ở bước R14 của windows.yml. -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            DowngradeErrorMessage='Da co phien ban moi hon. Hay go phien ban do truoc.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Lich va Van hoa Viet'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='ProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='LichVanHoaViet'>
                        <Component Id='MainExe' Guid='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D10' Win64='$(var.Win64)'>
                            <File Id='LichVietExe' Name='LichViet.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\LichViet.exe'/>
                            <RegistryValue Root='HKCU' Key='Software\Clevix\LichVanHoaViet' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
                            <RemoveFolder Id='RemoveAppFolder' On='uninstall'/>
                            <RemoveFolder Id='RemoveProgramsFolder' Directory='ProgramsFolder' On='uninstall'/>
                        </Component>
                        <!-- Giao thức lichviet: — bấm vào thông báo, Windows chạy LichViet.exe "lichviet:nguoi/<id>?…" và ứng dụng mở
                             đúng hồ sơ (src/toasts.rs). URI chỉ có UUID và băm nội dung, không có tên hay ngày (BM2-15). -->
                        <Component Id='ProtocolHandler' Guid='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D13' Win64='$(var.Win64)'>
                            <RegistryKey Root='HKCU' Key='Software\Classes\lichviet'>
                                <RegistryValue Type='string' Value='URL:Lich Viet' KeyPath='yes'/>
                                <RegistryValue Name='URL Protocol' Type='string' Value=''/>
                                <RegistryKey Key='DefaultIcon'>
                                    <RegistryValue Type='string' Value='[APPLICATIONFOLDER]LichViet.exe,0'/>
                                </RegistryKey>
                                <RegistryKey Key='shell\open\command'>
                                    <RegistryValue Type='string' Value='"[APPLICATIONFOLDER]LichViet.exe" "%1"'/>
                                </RegistryKey>
                            </RegistryKey>
                        </Component>
                        <Component Id='FontLicense' Guid='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D11' Win64='$(var.Win64)'>
                            <File Id='OflTxt' Name='OFL.txt' DiskId='1' Source='ui\fonts\OFL.txt'/>
                            <RegistryValue Root='HKCU' Key='Software\Clevix\LichVanHoaViet' Name='ofl' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Component Id='StartMenuShortcut' Guid='6B1D2C5E-7A0F-4C8B-9E3D-2F4A6B8C1D12'>
                    <!-- AppUserModelID trên lối tắt: ứng dụng chưa đóng gói (MSI, không MSIX) cần định danh này để Windows
                         nhận thông báo đặt lịch (02 §7.5, R-WIN-1). Phải trùng platform::AUMID trong src/platform.rs. -->
                    <Shortcut Id='AppShortcut' Name='Lich va Van hoa Viet' Target='[APPLICATIONFOLDER]LichViet.exe' WorkingDirectory='APPLICATIONFOLDER' Icon='ProductICO'>
                        <ShortcutProperty Key='System.AppUserModel.ID' Value='ClevixLab.LichVanHoaViet'/>
                    </Shortcut>
                    <RegistryValue Root='HKCU' Key='Software\Clevix\LichVanHoaViet' Name='shortcut' Type='integer' Value='1' KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature Id='Main' Title='Lich va Van hoa Viet' Level='1' Absent='disallow'>
            <ComponentRef Id='MainExe'/>
            <ComponentRef Id='FontLicense'/>
            <ComponentRef Id='StartMenuShortcut'/>
            <ComponentRef Id='ProtocolHandler'/>
        </Feature>

        <!-- Giao dien bo cai (BM2-22, MA3N-25-09): Welcome -> Verify -> Progress -> Exit, khong co trang giay phep. Trang
             ket thuc (cai dat va go bo khi chay lai .msi) ghi ro du lieu ca nhan duoc GIU va nam o dau. Bang MSI dung ma
             trang 1252 nen cau viet khong dau, nhu ten san pham; cau co dau day du nam o trang Gioi thieu cua ung dung.
             Go tu Cai dat Windows (giao dien co ban) khong hien hop thoai nay - xem docs/04-BUILD-NATIVE.md. -->
        <UI Id='LvhvUI'>
            <TextStyle Id='WixUI_Font_Normal' FaceName='Tahoma' Size='8'/>
            <TextStyle Id='WixUI_Font_Bigger' FaceName='Tahoma' Size='12'/>
            <TextStyle Id='WixUI_Font_Title' FaceName='Tahoma' Size='9' Bold='yes'/>
            <Property Id='DefaultUIFont' Value='WixUI_Font_Normal'/>
            <Property Id='WixUI_Mode' Value='Minimal'/>
            <DialogRef Id='ErrorDlg'/>
            <DialogRef Id='FatalError'/>
            <DialogRef Id='FilesInUse'/>
            <DialogRef Id='MsiRMFilesInUse'/>
            <DialogRef Id='PrepareDlg'/>
            <DialogRef Id='ProgressDlg'/>
            <DialogRef Id='ResumeDlg'/>
            <DialogRef Id='UserExit'/>
            <DialogRef Id='WelcomeDlg'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='VerifyReadyDlg'>1</Publish>
            <Publish Dialog='VerifyReadyDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='1'>NOT Installed</Publish>
            <Publish Dialog='VerifyReadyDlg' Control='Back' Event='NewDialog' Value='MaintenanceTypeDlg' Order='2'>Installed</Publish>
            <Publish Dialog='MaintenanceWelcomeDlg' Control='Next' Event='NewDialog' Value='MaintenanceTypeDlg'>1</Publish>
            <Publish Dialog='MaintenanceTypeDlg' Control='RepairButton' Event='NewDialog' Value='VerifyReadyDlg'>1</Publish>
            <Publish Dialog='MaintenanceTypeDlg' Control='RemoveButton' Event='NewDialog' Value='VerifyReadyDlg'>1</Publish>
            <Publish Dialog='MaintenanceTypeDlg' Control='Back' Event='NewDialog' Value='MaintenanceWelcomeDlg'>1</Publish>
            <Publish Dialog='ExitDialog' Control='Finish' Event='EndDialog' Value='Return' Order='999'>1</Publish>
        </UI>
        <UIRef Id='WixUI_Common'/>
        <Property Id='WIXUI_EXITDIALOGOPTIONALTEXT' Value='Du lieu ca nhan (so Nguoi than: ho so, anh, tep dinh kem, thong tin bao tu) nam o %LOCALAPPDATA%\ClevixLab\LichVanHoaViet. Cai lai, nang cap hay go bo ung dung deu GIU NGUYEN thu muc nay. Muon xoa han du lieu: sau khi go, hay xoa thu muc do (nen tao tep sao luu truoc).'/>

        <Icon Id='ProductICO' SourceFile='assets\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>
        <Property Id='ARPURLINFOABOUT' Value='https://clevix.vn'/>
        <Property Id='ARPNOMODIFY' Value='1'/>
    </Product>
</Wix>

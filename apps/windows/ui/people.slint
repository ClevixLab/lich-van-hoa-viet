// Mô-đun "Người thân" (v0.2 đợt 3) — giao diện Windows theo đặc tả docs/v0.2/08-DAC-TA-GIAO-DIEN-NGUOI-THAN.md.
// Tệp này chỉ hiển thị: mọi tính toán (ngày giỗ, nhắc, danh sách theo kỳ, .ics, sao lưu, kiểm dữ liệu) ở Rust
// (src/people.rs → lvhv-ffi → lvhv-memorial / lvhv-store / lvhv-backup).
import { LineEdit, ComboBox, CheckBox, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, T, S, Icon, Card, Btn, LinkBtn, RoundBtn } from "common.slint";

// Một mục sự kiện (§2 "Mục sự kiện"). kind: 0 giỗ, 1 tiên thường, 2 sinh nhật, 3 sự kiện.
export struct PItem {
    day: string, wd: string, mon: string,
    line1: string, line2: string, line3: string,
    kind: int, kind-text: string, right: string,
    today: bool, past: bool, sunday: bool,
    pid: string, header: string, memorial: bool,
}
export struct PRow { id: string, initial: string, name: string, rel: string, summary: string }
export struct KV { k: string, v: string }
export struct ChipRow { items: [string] }
export struct EvRow { id: string, text: string }
export struct RemCard { title: string, sub: string, pid: string, memorial: bool }
export struct ErrItem { text: string, key: string }

export global People {
    // Trang đang mở: sap-toi | theo-ky | ho-so | sao-luu | nguoi | form | bao-tu | su-kien | tuong-niem
    in-out property <string> page: "sap-toi";
    in-out property <string> back-label: "‹ Về danh sách hồ sơ";
    in-out property <string> store-error;
    // R14: kho không mở được (chuyển đổi lỗi) → khung báo chỉ xem + nút mở thư mục dữ liệu để chép dự phòng.
    in-out property <bool> store-failed;
    callback open-data-dir();
    in-out property <string> toast;
    in-out property <bool> has-any;
    in-out property <float> scroll-frac: 0;
    in-out property <bool> defaults-open: false;
    in-out property <[ErrItem]> f-errors;
    // Thẻ nhắc trên Tờ lịch (08 §5.5)
    in-out property <bool> sheet-has-card;
    in-out property <RemCard> sheet-card;
    in-out property <int> sheet-more;

    // Sắp tới
    in-out property <[PItem]> upcoming;
    in-out property <[RemCard]> cards;
    in-out property <int> cards-more;
    in-out property <bool> backup-nag;
    in-out property <string> backup-nag-text;
    in-out property <string> notif-status;
    in-out property <bool> notif-ok;
    in-out property <bool> settings-open: true;
    in-out property <bool> rem-enabled: true;
    in-out property <bool> show-names: false;
    in-out property <[bool]> def-offs;
    in-out property <string> def-custom;
    in-out property <string> def-hh: "07";
    in-out property <string> def-mm: "00";
    in-out property <string> def-error;

    // Theo kỳ
    in-out property <int> pkind: 1;   // 0 tuần, 1 tháng, 2 quý, 3 năm
    in-out property <int> pfilter: 0; // 0 tất cả, 1 đã mất, 2 đang sống
    in-out property <string> ptitle;
    in-out property <string> pcount;
    in-out property <bool> pcurrent;
    in-out property <string> pnote;
    in-out property <string> pempty;
    in-out property <[PItem]> pitems;

    // Hồ sơ (danh sách)
    in-out property <[PRow]> dead;
    in-out property <[PRow]> living;

    // Sao lưu
    in-out property <string> last-backup;
    in-out property <bool> ics-enabled;
    in-out property <string> ics-note;
    in-out property <int> nag-index; // 0: 30, 1: 60, 2: 90, 3: không nhắc
    in-out property <string> restore-file: "Chưa chọn tệp.";
    in-out property <string> restore-pw;
    in-out property <string> restore-error;

    // Hồ sơ một người
    in-out property <string> v-id;
    in-out property <bool> v-dead;
    in-out property <string> v-name;
    in-out property <string> v-initial;
    in-out property <string> v-rel;
    in-out property <string> v-sub;
    in-out property <bool> v-has-photo;
    in-out property <image> v-photo;
    in-out property <[PItem]> v-next;
    in-out property <[KV]> v-info;
    in-out property <[KV]> v-notice;
    in-out property <[image]> v-notice-photos;
    in-out property <bool> v-notice-open: false;
    in-out property <[EvRow]> v-events;
    in-out property <string> v-remind;
    in-out property <bool> v-missing;

    // Biểu mẫu người (đã mất / đang sống)
    in-out property <bool> f-dead: true;
    in-out property <string> f-title;
    in-out property <string> f-subtitle;
    in-out property <string> f-summary;  // "Còn n chỗ cần sửa"
    in-out property <string> f-danh-xung;
    in-out property <string> f-ho-ten;
    in-out property <string> f-ten-hieu;
    in-out property <string> f-quan-he;
    in-out property <string> f-ghi-chu;
    // YC-2026-07: giới tính (0 Nam, 1 Nữ, 2 Không ghi) — chỉ hiện khi lõi nhận trường `gioi_tinh`; gợi ý cách gọi theo
    // người sống / đã mất, chia sẵn thành hàng.
    in-out property <int> f-gender: 2;
    in-out property <bool> gender-ok: false;
    in-out property <[ChipRow]> dx-rows;
    in-out property <string> e-danh-xung;
    in-out property <string> e-ho-ten;
    in-out property <string> e-ten-hieu;
    in-out property <string> e-quan-he;
    in-out property <string> e-ghi-chu;
    // Ngày mất (dd-)
    in-out property <int> dd-cal;
    in-out property <string> dd-d;
    in-out property <string> dd-m;
    in-out property <string> dd-y;
    in-out property <bool> dd-leap;
    in-out property <bool> dd-unknown;
    in-out property <bool> dd-leap-visible: true;
    in-out property <string> dd-leap-label: "Tháng nhuận";
    in-out property <string> dd-note;
    in-out property <string> dd-result;
    in-out property <string> dd-error;
    // Ngày sinh (bd-)
    in-out property <int> bd-cal;
    in-out property <int> bd-prec; // 0 đủ ngày, 1 chỉ năm
    in-out property <string> bd-d;
    in-out property <string> bd-m;
    in-out property <string> bd-y;
    in-out property <bool> bd-leap;
    in-out property <bool> bd-leap-visible: true;
    in-out property <string> bd-leap-label: "Tháng nhuận";
    in-out property <string> bd-note;
    in-out property <string> bd-result;
    in-out property <string> bd-error;
    in-out property <string> f-noi-sinh;
    in-out property <string> e-noi-sinh;
    in-out property <string> f-tuoi-line;
    in-out property <bool> f-tuoi-manual;
    in-out property <string> f-tuoi;
    in-out property <string> e-tuoi;
    in-out property <string> f-noi-an-tang;
    in-out property <string> e-noi-an-tang;
    in-out property <bool> f-has-photo;
    in-out property <image> f-photo;
    in-out property <string> e-photo;
    // Thông tin báo tử (n-), dùng chung cho biểu mẫu người đã mất và "Cập nhật: đã mất"
    in-out property <bool> n-open;
    in-out property <string> n-by;
    in-out property <string> n-place;
    in-out property <string> n-d;
    in-out property <string> n-m;
    in-out property <string> n-y;
    in-out property <string> n-reason;
    in-out property <string> n-note;
    in-out property <[image]> n-photos;
    in-out property <string> e-notice;
    // Nhắc (r-) và sinh nhật âm (r2-)
    in-out property <bool> r-enabled: true;
    in-out property <[bool]> r-offs;
    in-out property <string> r-custom;
    in-out property <string> r-hh: "07";
    in-out property <string> r-mm: "00";
    in-out property <bool> r-tt;
    in-out property <string> r-error;
    in-out property <string> r-warn;
    in-out property <bool> f-am;
    in-out property <bool> f-am-same: true;
    in-out property <bool> f-am-allowed;
    in-out property <bool> r2-enabled: true;
    in-out property <[bool]> r2-offs;
    in-out property <string> r2-custom;
    in-out property <string> r2-hh: "07";
    in-out property <string> r2-mm: "00";
    in-out property <string> r2-error;
    in-out property <bool> f-feb29;
    in-out property <int> f-feb29-rule; // 0 feb28, 1 mar1
    // Tưởng niệm
    in-out property <bool> f-mem-open: false;
    in-out property <int> f-gio-het: 2;
    in-out property <string> f-loi;
    in-out property <string> f-nguong: "60";
    in-out property <string> e-nguong;

    // "Cập nhật: đã mất" (md-)
    in-out property <string> md-name;
    in-out property <int> md-cal;
    in-out property <string> md-d;
    in-out property <string> md-m;
    in-out property <string> md-y;
    in-out property <bool> md-leap;
    in-out property <bool> md-unknown;
    in-out property <bool> md-leap-visible: true;
    in-out property <string> md-leap-label: "Tháng nhuận";
    in-out property <string> md-note;
    in-out property <string> md-result;
    in-out property <string> md-error;

    // Biểu mẫu sự kiện (ev-, ed-, er-)
    in-out property <string> ev-person;
    in-out property <bool> ev-dead;
    in-out property <string> ev-heading;
    in-out property <[string]> ev-types;
    in-out property <int> ev-type: 0;
    in-out property <bool> ev-other;
    in-out property <string> ev-new-type;
    in-out property <string> e-new-type;
    in-out property <string> ev-title;
    in-out property <string> e-title;
    in-out property <int> ed-cal;
    in-out property <string> ed-d;
    in-out property <string> ed-m;
    in-out property <string> ed-y;
    in-out property <bool> ed-leap;
    in-out property <bool> ed-unknown;
    in-out property <bool> ed-leap-visible: true;
    in-out property <string> ed-leap-label: "Tháng nhuận";
    in-out property <string> ed-note;
    in-out property <string> ed-result;
    in-out property <string> ed-error;
    in-out property <bool> ev-recurring;
    in-out property <bool> er-enabled: true;
    in-out property <[bool]> er-offs;
    in-out property <string> er-custom;
    in-out property <string> er-hh: "07";
    in-out property <string> er-mm: "00";
    in-out property <string> er-error;
    in-out property <string> ev-ghi-chu;
    in-out property <string> e-ev-ghi-chu;

    // Tưởng niệm (m-)
    in-out property <string> m-dateline;
    in-out property <string> m-rel;
    in-out property <string> m-name;
    in-out property <bool> m-long;
    in-out property <string> m-hieu;
    in-out property <string> m-years;
    in-out property <string> m-tuoi;
    in-out property <string> m-loi;
    in-out property <string> m-initial;
    in-out property <bool> m-has-photo;
    in-out property <image> m-photo;
    in-out property <bool> m-incense: true;
    in-out property <bool> m-smoke: true;

    // Hộp thoại: "" | xac-nhan | ics | tao-sao-luu | khoi-phuc | thay-toan-bo | bo-thay-doi
    in-out property <string> dlg;
    in-out property <string> dlg-title;
    in-out property <[string]> dlg-lines;
    in-out property <string> dlg-ok: "Đồng ý";
    in-out property <string> dlg-cancel: "Hủy";
    in-out property <bool> dlg-danger;
    in-out property <bool> dlg-busy;
    in-out property <string> pw1;
    in-out property <string> pw2;
    in-out property <string> e-pw1;
    in-out property <string> e-pw2;

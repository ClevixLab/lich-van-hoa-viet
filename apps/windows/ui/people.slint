    callback go(string);            // chuyển trang con (sap-toi, theo-ky, ho-so, sao-luu)
    callback back();
    callback open-person(string);
    callback open-memorial(string);
    callback add-dead();
    callback add-living();
    callback edit-person();
    callback delete-person();
    callback mark-deceased();
    callback add-event();

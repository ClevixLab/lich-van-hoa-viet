// Lịch và Văn hóa Việt — giao diện Windows (Slint 1.8). Bảng màu, cỡ chữ và bố cục theo
// pwa/src/style.css. Mọi phép tính lịch ở Rust (src/main.rs → lvhv-ffi); tệp này chỉ hiển thị.
//
// Phông chữ: nhúng hết vào .exe (không phụ thuộc phông của máy): "LVHV Serif" (Lora rút gọn cho chữ
// Việt) cho tiêu đề và số, "LVHV Sans" (Be Vietnam Pro rút gọn) cho chữ thường. Biểu tượng là SVG
// (không dùng ký tự ‹ › ✕ ▦ ▲ ▼ — các ký tự này không có trong phông nên máy phải mượn phông khác).
import { LineEdit, ComboBox, CheckBox, ScrollView, Palette } from "std-widgets.slint";
import { Gio, Cell, GoodRow, Block, ChipRow, Sheet, Theme, T, S, Icon, ClevixLogo, Card, Btn, LinkBtn, RoundBtn, LabelBox, Bullets, Chip, Chips, Fact } from "common.slint";
import { People, PeopleView, PItem, PRow, KV, EvRow, RemCard, ErrItem } from "people.slint";
export { Gio, Cell, GoodRow, Block, ChipRow, Sheet, Theme } from "common.slint";
export { People, PItem, PRow, KV, EvRow, RemCard, ErrItem } from "people.slint";

import "fonts/LVHVSerif-Regular.ttf";
import "fonts/LVHVSerif-SemiBold.ttf";
import "fonts/LVHVSerif-Bold.ttf";
import "fonts/LVHVSerif-Italic.ttf";
import "fonts/LVHVSans-Regular.ttf";
import "fonts/LVHVSans-SemiBold.ttf";
import "fonts/LVHVSans-Bold.ttf";


// ---------------- Dữ liệu dùng chung ----------------

export global Data {
    in-out property <Sheet> sheet;
    in-out property <[Gio]> gio;
    in-out property <bool> can-prev: true;
    in-out property <bool> can-next: true;
    in-out property <bool> is-today: true;
    // Mục "Chi tiết" của tờ lịch: giữ trạng thái mở khi chuyển ngày (như bản web).
    in-out property <bool> details-open: false;
    // Chỉ dùng cho chế độ chụp màn hình: cuộn trang đang mở tới vị trí 0..1.
    in-out property <float> scroll-frac: 0;
    // Bảng tháng
    in-out property <[Cell]> cells;
    in-out property <int> view-month: 1;
    in-out property <string> view-year: "2026";
    in-out property <bool> view-can-prev: true;
    in-out property <bool> view-can-next: true;
    // Chọn ngày tốt
    in-out property <[string]> activities;
    in-out property <int> act: -1;
    in-out property <int> range: 1;
    in-out property <string> from-text;
    in-out property <string> to-text;
    in-out property <string> birth;
    in-out property <string> birth-cc;
    in-out property <string> summary: "Chọn một việc ở trên để xem những ngày phù hợp.";
    in-out property <string> hint;
    in-out property <[GoodRow]> good;
    in-out property <int> more: 0;
    // Đổi ngày
    in-out property <string> s-text;
    in-out property <string> s-big;
    in-out property <string> s-sub;
    in-out property <string> s-link;
    in-out property <bool> s-ok;
    in-out property <int> l-day: 1;
    in-out property <int> l-month: 1;
    in-out property <string> l-year;
    in-out property <bool> l-leap;
    in-out property <string> l-big;
    in-out property <bool> l-ok;
    in-out property <string> today-text;
    in-out property <string> range-text;
    // Giới thiệu
    in-out property <bool> about-rules: false;
    in-out property <string> version;
    in-out property <string> running-version;
    in-out property <string> copyright-sign;
    in-out property <string> copyright-holder;
    in-out property <string> version-line;
    in-out property <bool> remind: false;
    in-out property <string> method-text;
    in-out property <string> attribution;
    in-out property <string> cadao-count-text;
    in-out property <[Block]> rule-sources;
    in-out property <[Block]> cadao-sources;

    callback step(int);
    callback go-today();
    callback open-month();
    callback month-shift(int);
    callback month-set(int);
    callback year-set(string);
    callback month-pick(int);
    callback recompute-good();
    callback open-good(int);
    callback load-more();
    callback convert-solar();
    callback convert-lunar();
    callback open-solar();
    callback open-lunar();
    callback check-update();
    callback remind-later();
    callback open-rules();
    callback open-people();
}

// ---------------- Tờ lịch ----------------

component SheetPage inherits Rectangle {
    in property <Sheet> s;
    callback open-month;
    callback day-swipe(int);

    // Vuốt ngang để đổi ngày. SwipeGestureHandler PHẢI bọc nội dung (là cha của ScrollView): nó giữ lại
    // cú nhấn chuột 100 ms rồi chuyển cho các phần tử CON. Bản 0.1.2 đặt nó là anh em nằm đè lên
    // ScrollView nên cú nhấn bị nuốt mất — mọi nút trong tờ lịch (Chi tiết, Xem thêm, dải tháng) không
    // phản hồi. Kiểm thử `ui_tests` bấm thật vào các nút này để lỗi không quay lại.
    SwipeGestureHandler {
        width: 100%; height: 100%;
        handle-swipe-left: true;
        handle-swipe-right: true;
        swiped => {
            if (self.current-position.x < self.pressed-position.x - 60px) { root.day-swipe(1); }
            else if (self.current-position.x > self.pressed-position.x + 60px) { root.day-swipe(-1); }
        }
        sv := ScrollView {
            width: 100%; height: 100%;
            property <float> sf: Data.scroll-frac;
            changed sf => { self.viewport-y = min(0px, -(self.viewport-height - self.visible-height) * sf); }
            VerticalLayout {
                alignment: start;
                padding: 16px; padding-top: 6px;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 560px;
                        preferred-width: 560px;
                        spacing: 10px;
                        // Ngày trước / Hôm nay / Ngày sau
                        HorizontalLayout {
                            RoundBtn { icon: @image-url("icons/prev.svg"); label: "Ngày trước"; enabled: Data.can-prev; clicked => { Data.step(-1); } }
                            Rectangle { horizontal-stretch: 1; }
                            Btn { text: "Hôm nay"; kind: "primary"; enabled: !Data.is-today; size: 16; width: 150px; clicked => { Data.go-today(); } }
                            Rectangle { horizontal-stretch: 1; }
                            RoundBtn { icon: @image-url("icons/next.svg"); label: "Ngày sau"; enabled: Data.can-next; clicked => { Data.step(1); } }
                        }
                        Rectangle {
                            VerticalLayout {
                                padding-top: 9px;
                                Card {
                                    border-radius: 8px;
                                    clip: true;
                                    VerticalLayout {
                                        // Dải đỏ đầu tờ — bấm để mở bảng tháng
                                        Rectangle {
                                            background: band-ta.has-hover ? Theme.red : Theme.red-deep;
                                            height: 64px;
                                            accessible-role: button;
                                            accessible-label: s.month-title + " năm " + s.year + ". Mở bảng tháng để chọn ngày khác";
                                            accessible-action-default => { root.open-month(); }
                                            HorizontalLayout {
                                                alignment: center; spacing: 10px;
                                                S { text: s.month-title; color: Theme.band-ink; size: 25; vertical-alignment: center; }
                                                S { text: s.year; color: Theme.band-ink; size: 25; font-weight: 400; opacity: 0.85; vertical-alignment: center; }
                                                VerticalLayout { alignment: center; Icon { source: @image-url("icons/grid.svg"); tint: Theme.band-ink; width: 22px; height: 22px; opacity: 0.85; } }
                                            }
                                            band-ta := TouchArea { clicked => { root.open-month(); } mouse-cursor: pointer; }
                                        }
                                        // Mép răng cưa
                                        Rectangle {
                                            height: 6px;
                                            HorizontalLayout {
                                                for i in 64: Rectangle { width: 10px; Rectangle { y: -3.4px; width: 6.8px; height: 6.8px; border-radius: 3.4px; background: Theme.red-deep; } }
                                            }
                                        }
                                        VerticalLayout {
                                            padding-left: 22px; padding-right: 22px; padding-bottom: 18px; spacing: 0;
                                            // Ngày dương
                                            Rectangle {
                                              accessible-role: text;
                                              accessible-label: s.weekday + ", ngày " + s.day + " " + s.month-title + " năm " + s.year;
                                              VerticalLayout {
                                                padding-top: 14px; padding-bottom: 10px;
                                                S { text: s.weekday; size: 25; color: s.sunday ? Theme.red-ink : Theme.ink; horizontal-alignment: center; }
                                                S { text: s.day; size: 170; font-weight: 700; color: s.sunday ? Theme.red-ink : Theme.ink; horizontal-alignment: center; }
                                                if s.is-today: HorizontalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        border-width: 1.5px; border-color: Theme.red-ink; border-radius: 13px; height: 26px; width: ht.preferred-width + 26px;
                                                        ht := T { text: "Hôm nay"; color: Theme.red-ink; font-weight: 700; size: 14; wrap: no-wrap; }
                                                    }
                                                }
                                              }
                                            }
                                            Rectangle { height: 1px; background: Theme.rule; }
                                            // Âm lịch + Can Chi
                                            HorizontalLayout {
                                                padding-top: 16px; padding-bottom: 16px; spacing: 18px;
                                                VerticalLayout {
                                                    width: 130px; alignment: center; spacing: 0px;
                                                    T { text: "Âm lịch"; color: Theme.ink3; size: 13; font-weight: 600; horizontal-alignment: center; }
                                                    S { text: s.lunar-day; size: 56; font-weight: 700; color: s.lunar-key ? Theme.red-ink : Theme.gold; horizontal-alignment: center; }
                                                    S { text: s.lunar-month; size: 17; horizontal-alignment: center; wrap: word-wrap; }
                                                    T { text: s.month-len; color: Theme.ink3; size: 13; horizontal-alignment: center; }
                                                }
                                                Rectangle { width: 1px; background: Theme.rule; }
                                                VerticalLayout {
                                                    alignment: center; spacing: 10px;
                                                    for row in [[{k: "Năm", v: s.cc-year}, {k: "Tháng", v: s.cc-month}], [{k: "Ngày", v: s.cc-day}, {k: "Tiết", v: s.tiet}]]: HorizontalLayout {
                                                        spacing: 14px;
                                                        for kv in row: Rectangle {
                                                            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                                                            accessible-role: text;
                                                            accessible-label: kv.k + ": " + kv.v;
                                                            VerticalLayout {
                                                                spacing: 0px;
                                                                T { text: kv.k; color: Theme.ink3; size: 13; font-weight: 600; }
                                                                S { text: kv.v; size: 19; wrap: word-wrap; }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            Rectangle { height: 1px; background: Theme.rule; }
                                            // Nhãn: hoàng đạo/hắc đạo, trực, đánh giá
                                            HorizontalLayout {
                                                padding-top: 16px; padding-bottom: 4px; spacing: 8px;
                                                LabelBox {
                                                    horizontal-stretch: 1.25; preferred-width: 12.5px;
                                                    k: s.than-kind; v: s.than-name;
                                                    bg: s.hoang-dao ? Theme.gold-tint : Theme.paper2;
                                                    kc: s.hoang-dao ? Theme.gold : Theme.ink2;
                                                    fg: s.hoang-dao ? Theme.gold : Theme.ink;
                                                }
                                                LabelBox { horizontal-stretch: 1; preferred-width: 10px; k: "Trực"; v: s.truc; }
                                                LabelBox {
                                                    horizontal-stretch: 1.15; preferred-width: 11.5px;
                                                    k: "Đánh giá"; v: s.rating;
                                                    bg: s.rating-level >= 3 ? Theme.green-tint : (s.rating-level <= 0 ? Theme.red-tint : Theme.paper2);
                                                    fg: s.rating-level >= 2 ? Theme.green : (s.rating-level <= 0 ? Theme.red-ink : Theme.ink);
                                                }
                                            }
                                            // Giờ hoàng đạo
                                            VerticalLayout {
                                                padding-top: 18px; spacing: 8px;
                                                S { text: "Giờ hoàng đạo"; size: 19; }
                                                for row in [0, 1]: HorizontalLayout {
                                                    spacing: 8px;
                                                    for col in [0, 1, 2]: Rectangle {
                                                        property <int> idx: row * 3 + col;
                                                        horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                                                        border-width: 1px; border-color: Theme.rule; border-radius: 10px; height: 54px;
                                                        accessible-role: text;
                                                        accessible-label: idx < Data.gio.length ? "Giờ " + Data.gio[idx].chi + ", " + Data.gio[idx].range : "";
                                                        VerticalLayout {
                                                            alignment: center; spacing: 0px;
                                                            S { text: idx < Data.gio.length ? Data.gio[idx].chi : ""; size: 18; font-weight: 700; horizontal-alignment: center; }
                                                            T { text: idx < Data.gio.length ? Data.gio[idx].range : ""; size: 13; color: Theme.ink2; horizontal-alignment: center; }
                                                        }
                                                    }
                                                }
                                            }
                                            // Nên / Kỵ
                                            HorizontalLayout {
                                                padding-top: 20px; spacing: 18px;
                                                Rectangle { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; min-height: bn.preferred-height; bn := Bullets { y: 0; width: parent.width; height: self.preferred-height; title: "Nên làm"; what: "việc nên làm"; accent: Theme.green; items: s.nen; } }
                                                Rectangle { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; min-height: bk.preferred-height; bk := Bullets { y: 0; width: parent.width; height: self.preferred-height; title: "Kỵ"; what: "việc nên tránh"; accent: Theme.red; items: s.ky; } }
                                            }
                                            // Ca dao, tục ngữ
                                            if s.has-cadao: VerticalLayout {
                                                padding-top: 20px;
                                                Rectangle { height: 1px; background: Theme.rule; }
                                                Rectangle {
                                                  accessible-role: text;
                                                  accessible-label: s.cadao-type + " trong ngày";
                                                  VerticalLayout {
                                                    padding-top: 18px; padding-bottom: 16px; spacing: 2px;
                                                    for line in s.cadao: S { text: line; size: 20; font-weight: 400; font-italic: true; horizontal-alignment: center; wrap: word-wrap; }
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 8px; padding-top: 6px;
                                                        VerticalLayout { alignment: center; Rectangle { width: 26px; height: 1px; background: Theme.ink3; } }
                                                        T { text: s.cadao-type; color: Theme.ink3; size: 13; font-weight: 600; wrap: no-wrap; }
                                                        VerticalLayout { alignment: center; Rectangle { width: 26px; height: 1px; background: Theme.ink3; } }
                                                    }
                                                  }
                                                }
                                                Rectangle { height: 1px; background: Theme.rule; }
                                            }
                                            // Chi tiết (bấm để mở/thu gọn)
                                            Rectangle {
                                                min-height: 52px;
                                                accessible-role: button;
                                                accessible-label: Data.details-open ? "Thu gọn chi tiết" : "Mở chi tiết";
                                                accessible-checked: Data.details-open;
                                                accessible-action-default => { Data.details-open = !Data.details-open; }
                                                background: det-ta.has-hover ? Theme.paper2 : transparent;
                                                border-radius: 8px;
                                                HorizontalLayout {
                                                    padding-top: 14px; padding-bottom: 6px;
                                                    S { text: "Chi tiết"; size: 19; vertical-alignment: center; horizontal-stretch: 1; }
                                                    VerticalLayout { alignment: center; Icon { source: Data.details-open ? @image-url("icons/up.svg") : @image-url("icons/down.svg"); tint: Theme.ink2; } }
                                                }
                                                det-ta := TouchArea { clicked => { Data.details-open = !Data.details-open; } mouse-cursor: pointer; }
                                            }
                                            if Data.details-open: VerticalLayout {
                                                spacing: 8px; padding-top: 6px;
                                                T { text: "Sao tốt"; color: Theme.ink3; size: 13; font-weight: 600; }
                                                Chips { rows: s.sao-tot; bg: Theme.green-tint; fg: Theme.green; }
                                                T { text: "Sao xấu"; color: Theme.ink3; size: 13; font-weight: 600; }
                                                Chips { rows: s.sao-xau; bg: Theme.red-tint; fg: Theme.red-ink; }
                                                Rectangle { height: 1px; background: Theme.rule; }
                                                HorizontalLayout { spacing: 14px; Fact { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; k: "Nhị thập bát tú"; v: s.tu; } Fact { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; k: "Nạp âm"; v: s.nap-am; } }
                                                HorizontalLayout { spacing: 14px; Fact { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; k: "Giờ Tý đầu ngày"; v: s.hour-ty; } Fact { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; k: "Tuổi xung"; v: s.xung; } }
                                                Fact { k: "Điểm chung"; v: s.score; }
                                                Rectangle { height: 1px; background: Theme.rule; }
                                                T { text: "Theo Ngọc Hạp Thông Thư; tham khảo."; color: Theme.ink3; size: 13; }
                                                LinkBtn { text: "Nguồn quy tắc"; size: 14; clicked => { Data.open-rules(); } }
                                            }
                                        }
                                    }
                                }
                            }
                            // Hai khoen treo
                            Rectangle { x: parent.width * 0.27 - 7px; y: 0; width: 14px; height: 22px; border-radius: 7px; background: @linear-gradient(180deg, #d8d2ce 0%, #9d9592 100%); }
                            Rectangle { x: parent.width * 0.73 - 7px; y: 0; width: 14px; height: 22px; border-radius: 7px; background: @linear-gradient(180deg, #d8d2ce 0%, #9d9592 100%); }
                        }
                    }
                }
            }
        }
    }
}

// ---------------- Bảng tháng ----------------

component MonthGrid inherits VerticalLayout {
    in property <[Cell]> cells;
    in property <int> month;
    in property <string> year-text;
    in property <bool> can-prev;
    in property <bool> can-next;
    callback shift(int);
    callback set-month(int);
    callback set-year(string);
    callback pick(int);
    spacing: 6px;
    HorizontalLayout {
        spacing: 8px; padding-bottom: 4px;
        RoundBtn { icon: @image-url("icons/prev.svg"); label: "Tháng trước"; enabled: can-prev; clicked => { root.shift(-1); } }
        ComboBox {
            horizontal-stretch: 1;
            min-width: 110px;
            model: ["Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"];
            current-index: month - 1;
            selected => { root.set-month(self.current-index + 1); }
        }
        LineEdit {
            width: 92px;
            text: year-text;
            input-type: number;
            horizontal-alignment: center;
            accessible-label: "Năm";
            edited(t) => { root.set-year(t); }
        }
        RoundBtn { icon: @image-url("icons/next.svg"); label: "Tháng sau"; enabled: can-next; clicked => { root.shift(1); } }
    }
    HorizontalLayout {
        spacing: 4px;
        for w[i] in ["T2", "T3", "T4", "T5", "T6", "T7", "CN"]: T { text: w; font-weight: 700; color: i == 6 ? Theme.red-ink : Theme.ink3; horizontal-alignment: center; size: 13; }
    }
    for r in 6: HorizontalLayout {
        spacing: 4px;
        visible: r * 7 < cells.length;
        height: r * 7 < cells.length ? 52px : 0;
        for c in 7: Rectangle {
            property <Cell> cell: r * 7 + c < cells.length ? cells[r * 7 + c] : { blank: true };
            border-radius: 10px;
            background: cell.blank ? transparent : (cell.selected ? Theme.red-deep : (cell.key ? Theme.gold-tint : (ta.has-hover ? Theme.paper2 : transparent)));
            border-width: (cell.today && !cell.selected) ? 1.5px : 0;
            border-color: Theme.red;
            accessible-role: button;
            accessible-label: cell.label;
            accessible-action-default => { if (!cell.blank) { root.pick(cell.day); } }
            if !cell.blank: VerticalLayout {
                alignment: center; spacing: 0px;
                S { text: cell.day; size: 18; horizontal-alignment: center; color: cell.selected ? #ffffff : (cell.sunday ? Theme.red-ink : Theme.ink); }
                T { text: cell.lunar; size: 11; horizontal-alignment: center; font-weight: cell.key ? 700 : 400; color: cell.selected ? #ffffff : (cell.key ? Theme.red-ink : Theme.ink3); wrap: no-wrap; }
            }
            ta := TouchArea { enabled: !cell.blank; clicked => { root.pick(cell.day); } mouse-cursor: pointer; }
        }
    }
    HorizontalLayout {
        spacing: 8px; padding-top: 4px;
        VerticalLayout { alignment: center; Rectangle { width: 14px; height: 14px; border-radius: 3px; background: Theme.gold-tint; border-width: 1px; border-color: Theme.gold; } }
        T { text: "Mùng 1 và ngày rằm âm lịch"; color: Theme.ink2; size: 13; }
    }
}

// ---------------- Các trang khác ----------------

component H1 inherits VerticalLayout {
    in property <string> title;
    in property <string> lead;
    spacing: 4px;
    padding-bottom: 4px;
    S { text: title; size: 30; accessible-role: text; accessible-label: title; }
    if lead != "": T { text: lead; color: Theme.ink2; size: 16; }
}

component Panel inherits Card {
    border-radius: 14px;
}

component Blocks inherits VerticalLayout {
    in property <[Block]> blocks;
    spacing: 6px;
    for b in blocks: T {
        text: b.kind == "li" ? "• " + b.text : b.text;
        color: b.kind == "h" ? Theme.ink : Theme.ink2;
        font-weight: b.kind == "h" ? 700 : 400;
        size: b.kind == "h" ? 16 : 14;
    }
}

// Cột nội dung giữa trang (rộng tối đa 680 px, như .main của bản web).
component Page inherits ScrollView {
    property <float> sf: Data.scroll-frac;
    changed sf => { self.viewport-y = min(0px, -(self.viewport-height - self.visible-height) * sf); }
    VerticalLayout {
        alignment: start;
        padding: 16px; padding-top: 8px; padding-bottom: 24px;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                max-width: 680px; preferred-width: 680px;
                spacing: 14px;
                @children
            }
        }
    }
}

component GoodDaysPage inherits Page {
    H1 { title: "Chọn ngày tốt"; lead: "Chọn việc định làm và khoảng thời gian. Ngày được xếp từ điểm cao nhất."; }
    Panel {
        VerticalLayout {
            padding: 18px; spacing: 10px;
            S { text: "Việc định làm"; size: 19; }
            for row in (Data.activities.length + 3) / 4: HorizontalLayout {
                spacing: 8px;
                for col in 4: Btn {
                    property <int> idx: row * 4 + col;
                    horizontal-stretch: 1; preferred-width: 10px;
                    min-height: 56px;
                    opacity: idx < Data.activities.length ? 1 : 0;
                    enabled: idx < Data.activities.length;
                    text: idx < Data.activities.length ? Data.activities[idx] : "";
                    kind: "choice"; nowrap: false; size: 14;
                    active: Data.act == idx;
                    clicked => { Data.act = idx; Data.recompute-good(); }
                }
            }
            S { text: "Trong khoảng"; size: 19; }
            Rectangle {
                background: Theme.paper2; border-radius: 12px;
                HorizontalLayout {
                    padding: 4px; spacing: 4px;
                    for r[i] in ["Tuần này", "Tháng này", "3 tháng tới", "Tự chọn"]: Rectangle {
                        horizontal-stretch: 1;
                        min-height: 44px;
                        border-radius: 9px;
                        background: Data.range == i ? Theme.paper : (seg-ta.has-hover ? Theme.rule : transparent);
                        drop-shadow-blur: Data.range == i ? 3px : 0px;
                        drop-shadow-color: #00000026;
                        accessible-role: button; accessible-label: r; accessible-checked: Data.range == i;
                        accessible-action-default => { Data.range = i; Data.recompute-good(); }
                        T { text: r; size: 14; font-weight: 600; color: Data.range == i ? Theme.ink : Theme.ink2; wrap: no-wrap; horizontal-alignment: center; vertical-alignment: center; }
                        seg-ta := TouchArea { clicked => { Data.range = i; Data.recompute-good(); } mouse-cursor: pointer; }
                    }
                }
            }
            if Data.range == 3: HorizontalLayout {
                spacing: 12px;
                VerticalLayout { spacing: 4px; T { text: "Từ ngày (ngày/tháng/năm)"; color: Theme.ink2; size: 13; font-weight: 600; } LineEdit { text <=> Data.from-text; edited => { Data.recompute-good(); } } }
                VerticalLayout { spacing: 4px; T { text: "Đến ngày"; color: Theme.ink2; size: 13; font-weight: 600; } LineEdit { text <=> Data.to-text; edited => { Data.recompute-good(); } } }
            }
            T { text: "Năm sinh âm lịch (không bắt buộc)"; font-weight: 700; size: 15; }
            HorizontalLayout {
                spacing: 12px;
                LineEdit { width: 160px; text <=> Data.birth; placeholder-text: "Ví dụ 1976"; input-type: number; edited => { Data.recompute-good(); } }
                S { text: Data.birth-cc; color: Theme.gold; vertical-alignment: center; }
            }
            T { text: "Nhập năm âm lịch của ngày sinh (năm tuổi). Ai sinh trước Tết Nguyên đán thì lấy năm trước, ví dụ sinh 20/01/1977 dương lịch (trước Tết Đinh Tỵ) là năm Bính Thìn 1976."; color: Theme.ink3; size: 13; }
            T { text: "Năm sinh chỉ dùng để tránh ngày xung tuổi, không được lưu lại."; color: Theme.ink3; size: 13; }
        }
    }
    S { text: "Kết quả"; size: 22; }
    T { text: Data.summary; color: Theme.ink2; size: 16; accessible-role: text; accessible-label: self.text; }
    if Data.hint != "": T { text: Data.hint; color: Theme.ink3; size: 14; }
    for g[i] in Data.good: Rectangle {
        background: ta.has-hover ? Theme.paper2 : Theme.paper;
        border-radius: 12px; border-width: 1px; border-color: Theme.rule;
        accessible-role: button;
        accessible-label: g.l1 + ", " + g.l2 + ", điểm " + g.score + ". Mở tờ lịch ngày này";
        accessible-action-default => { Data.open-good(i); }
        HorizontalLayout {
            padding: 12px; spacing: 12px;
            VerticalLayout { width: 56px; alignment: center; spacing: 0px;
                S { text: g.day; size: 30; font-weight: 700; color: g.sunday ? Theme.red-ink : Theme.ink; horizontal-alignment: center; }
                T { text: g.mon; size: 13; color: Theme.ink3; horizontal-alignment: center; }
            }
            Rectangle { width: 1px; background: Theme.rule; }
            VerticalLayout { spacing: 2px; alignment: center; horizontal-stretch: 1;
                T { text: g.l1; font-weight: 700; size: 16; }
                T { text: g.l2; color: Theme.ink2; size: 14; }
                T { text: g.l3; color: Theme.ink2; size: 14; }
                T { text: g.reasons; color: Theme.green; size: 14; }
            }
            VerticalLayout { width: 52px; alignment: center; spacing: 0px;
                S { text: g.score; size: 24; font-weight: 700; color: Theme.gold; horizontal-alignment: center; }
                T { text: "điểm"; size: 12; color: Theme.ink3; horizontal-alignment: center; }
            }
        }
        ta := TouchArea { clicked => { Data.open-good(i); } mouse-cursor: pointer; }
    }
    if Data.more > 0: HorizontalLayout { alignment: center; Btn { text: "Xem thêm " + Data.more + " ngày"; kind: "outline"; clicked => { Data.load-more(); } } }
}

component ConvertPage inherits Page {
    H1 { title: "Đổi ngày"; lead: Data.range-text; }
    Panel {
        VerticalLayout {
            padding: 18px; spacing: 8px;
            S { text: "Dương lịch sang âm lịch"; size: 19; }
            T { text: "Ngày dương lịch (ngày/tháng/năm)"; color: Theme.ink2; size: 13; font-weight: 600; }
            LineEdit { text <=> Data.s-text; accessible-label: "Ngày dương lịch"; edited => { Data.convert-solar(); } }
            Rectangle {
                background: Data.s-ok ? Theme.paper2 : Theme.red-tint; border-radius: 10px;
                VerticalLayout {
                    padding: 12px; spacing: 4px;
                    S { text: Data.s-big; size: Data.s-ok ? 24 : 15; font-weight: 600; color: Data.s-ok ? Theme.ink : Theme.red-ink; wrap: word-wrap; }
                    if Data.s-ok: T { text: Data.s-sub; color: Theme.ink2; size: 15; }
                    if Data.s-ok: LinkBtn { text: Data.s-link; clicked => { Data.open-solar(); } }
                }
            }
        }
    }
    Panel {
        VerticalLayout {
            padding: 18px; spacing: 8px;
            S { text: "Âm lịch sang dương lịch"; size: 19; }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout { spacing: 4px; T { text: "Ngày"; color: Theme.ink2; size: 13; font-weight: 600; }
                    ComboBox {
                        model: ["Mùng 1","Mùng 2","Mùng 3","Mùng 4","Mùng 5","Mùng 6","Mùng 7","Mùng 8","Mùng 9","Mùng 10","Ngày 11","Ngày 12","Ngày 13","Ngày 14","Ngày 15","Ngày 16","Ngày 17","Ngày 18","Ngày 19","Ngày 20","Ngày 21","Ngày 22","Ngày 23","Ngày 24","Ngày 25","Ngày 26","Ngày 27","Ngày 28","Ngày 29","Ngày 30"];
                        current-index: Data.l-day - 1;
                        selected => { Data.l-day = self.current-index + 1; Data.convert-lunar(); }
                    }
                }
                VerticalLayout { spacing: 4px; T { text: "Tháng"; color: Theme.ink2; size: 13; font-weight: 600; }
                    ComboBox {
                        model: ["Tháng 1 (Giêng)","Tháng 2 (Hai)","Tháng 3 (Ba)","Tháng 4 (Tư)","Tháng 5 (Năm)","Tháng 6 (Sáu)","Tháng 7 (Bảy)","Tháng 8 (Tám)","Tháng 9 (Chín)","Tháng 10 (Mười)","Tháng 11 (Mười Một)","Tháng 12 (Chạp)"];
                        current-index: Data.l-month - 1;
                        selected => { Data.l-month = self.current-index + 1; Data.convert-lunar(); }
                    }
                }
                VerticalLayout { spacing: 4px; T { text: "Năm"; color: Theme.ink2; size: 13; font-weight: 600; }
                    LineEdit { text <=> Data.l-year; input-type: number; accessible-label: "Năm âm lịch"; edited => { Data.convert-lunar(); } }
                }
            }
            CheckBox { text: "Tháng nhuận"; checked <=> Data.l-leap; toggled => { Data.convert-lunar(); } }
            Rectangle {
                background: Data.l-ok ? Theme.paper2 : Theme.red-tint; border-radius: 10px;
                VerticalLayout {
                    padding: 12px; spacing: 4px;
                    S { text: Data.l-big; size: Data.l-ok ? 24 : 15; font-weight: 600; color: Data.l-ok ? Theme.ink : Theme.red-ink; wrap: word-wrap; }
                    if Data.l-ok: LinkBtn { text: "Mở tờ lịch ngày này"; clicked => { Data.open-lunar(); } }
                }
            }
        }
    }
    T { text: Data.today-text; color: Theme.ink3; size: 13; }
}

component Para inherits T {
    color: Theme.ink2;
    size: 16;
}

// Tiêu đề nhỏ trong một khung của Giới thiệu (như h3 của bản web).
component SubHead inherits S {
    size: 17;
    accessible-role: AccessibleRole.text;
    accessible-label: self.text;
}

// Một mục có chấm đầu dòng: tiêu đề in đậm (có thể rỗng) rồi phần giải thích. Slint chưa có chữ đậm giữa dòng, nên
// tiêu đề đứng thành dòng riêng (bản web: <strong> đầu câu).
component Bullet inherits HorizontalLayout {
    in property <string> title;
    in property <string> text;
    spacing: 10px;
    T { text: "•"; accessible-role: none; size: 16; color: Theme.red-ink; font-weight: 700; vertical-alignment: top; width: 12px; wrap: no-wrap; }
    VerticalLayout {
        spacing: 2px;
        if root.title != "": T { text: root.title; size: 16; font-weight: 700; color: Theme.ink; }
        Para { text: root.text; }
    }
}

// Một bước có số thứ tự (như <ol class="steps"> của bản web).
component Step inherits HorizontalLayout {
    in property <int> n;
    in property <string> text;
    spacing: 10px;
    Rectangle {
        width: 26px; height: 26px; border-radius: 13px; background: Theme.red-tint;
        T { text: root.n; size: 14; font-weight: 700; color: Theme.red-ink; horizontal-alignment: center; vertical-alignment: center; wrap: no-wrap; }
    }
    Para { text: root.text; }
}

component AboutPage inherits Page {
    if !Data.about-rules: VerticalLayout {
        spacing: 14px;
        HorizontalLayout {
            spacing: 16px; padding-top: 6px;
            Image { source: @image-url("../assets/icon.svg"); width: 72px; height: 72px; }
            VerticalLayout { alignment: center; spacing: 2px;
                S { text: "Lịch và Văn hóa Việt"; size: 28; }
                HorizontalLayout { alignment: start; spacing: 6px;
                    ClevixLogo { small: true; }
                    T { text: "Clevix Lab"; color: Theme.red-ink; font-weight: 700; size: 15; vertical-alignment: center; wrap: no-wrap; }
                }
                T { text: "Phiên bản " + Data.version + " (thử nghiệm)"; color: Theme.ink3; size: 13; }
            }
        }
        Panel { VerticalLayout { padding: 18px; spacing: 8px;
            S { text: "Phiên bản và cập nhật"; size: 19; }
            Para { text: Data.running-version; accessible-role: text; accessible-label: self.text; }
            Para { text: "Ứng dụng không tự kết nối mạng để bảo vệ quyền riêng tư. Bấm nút để mở cửa hàng ứng dụng hoặc trang tải về và cập nhật lên phiên bản mới nhất."; }
            HorizontalLayout { alignment: start; padding-top: 4px;
                Btn { text: "Kiểm tra cập nhật / Cập nhật"; kind: "primary"; clicked => { Data.check-update(); } }
            }
        } }
        // Nội dung như trang Giới thiệu của bản web 0.2.1 (pwa/src/ui/about.ts, PR #73), chỉnh cho đúng bản Windows:
        // thông báo của Windows đặt trước (không chạy nền), dữ liệu trong %LOCALAPPDATA%, không có mẹo Màn hình chính.
        Panel { VerticalLayout { padding: 18px; spacing: 10px;
            S { text: "Về ứng dụng"; size: 19; }
            Para { text: "Lịch và Văn hóa Việt là cuốn lịch vạn niên miễn phí và cũng là sổ tay gia đình: xem ngày âm dương, chọn ngày tốt, và không bao giờ quên ngày giỗ ông bà, cha mẹ hay sinh nhật người thân. Không quảng cáo, không cần tài khoản, dữ liệu chỉ nằm trên máy của bạn."; size: 17; color: Theme.ink; }
            SubHead { text: "Ứng dụng giúp bạn"; }
            Bullet { title: "Tờ lịch mỗi ngày"; text: "Từ năm 1900 đến năm 3000: ngày âm, Can Chi, tiết khí, giờ hoàng đạo và một câu ca dao, tục ngữ."; }
            Bullet { title: "Chọn ngày tốt"; text: "Cho việc lớn: sao tốt, sao xấu, việc nên làm và nên tránh, theo tuổi của bạn."; }
            Bullet { title: "Đổi ngày"; text: "Âm sang dương và ngược lại, kể cả tháng nhuận."; }
            Bullet { title: "Người thân"; text: "Ghi lại người đã khuất và người đang sống trong gia đình. Ngày giỗ được tự tính theo âm lịch mỗi năm (giỗ đầu, giỗ hết, giỗ thường), cùng sinh nhật dương lịch, sinh nhật âm lịch và những dịp riêng như tốt nghiệp, ngày cưới."; }
            Bullet { title: "Nhắc trước"; text: "Đúng ngày, 1, 3, 5, 10, 15 ngày hoặc số ngày bạn tự chọn (1–60), để kịp sắm lễ, báo anh em họ hàng. Windows hiện thông báo đúng giờ, kể cả khi ứng dụng đã đóng."; }
            Bullet { title: "Xem cả nhà có việc gì"; text: "Trong tuần, tháng, quý hay cả năm; lọc riêng người đã mất hoặc người đang sống."; }
            Bullet { title: "Trang tưởng niệm ngày giỗ"; text: "Bia ghi tên, năm sinh năm mất theo Can Chi, ảnh chân dung, bát hương ba nén và đôi nến. Gia đình có thể thêm ảnh mâm lễ của chính nhà mình."; }
            Bullet { title: "Thông tin báo tử"; text: "Khi một người thân qua đời: ai báo tin, mất ở đâu, ghi chú, kèm ảnh tin báo tử hoặc bản chụp giấy chứng tử."; }
            SubHead { text: "Bắt đầu trong một phút"; }
            Step { n: 1; text: "Mở mục Người thân, chọn Hồ sơ, rồi bấm “+ Thêm người đã mất” hoặc “+ Thêm người đang sống”."; }
            Step { n: 2; text: "Nhập họ tên, cách gọi (Ông, Bà, Bố, Mẹ…) và quan hệ (ví dụ “Ông nội”). Với người đã mất, nhập ngày mất theo dương lịch hoặc âm lịch — ứng dụng tự đổi và tính ngày giỗ hằng năm."; }
            Step { n: 3; text: "Chọn nhắc trước mấy ngày, bấm “Lưu”."; }
            Step { n: 4; text: "Mở Sắp tới để xem các ngày giỗ, sinh nhật gần nhất; mở Theo kỳ để xem theo tuần, tháng, quý, năm."; }
            Step { n: 5; text: "Đúng ngày giỗ, bấm “Mở trang tưởng niệm” để thắp nén hương tưởng nhớ."; }
            Step { n: 6; text: "Vào Sao lưu để cất một bản sao có mật khẩu, hoặc xuất tệp lịch (.ics) sang Outlook, Lịch của Windows hay lịch điện thoại."; }
            SubHead { text: "Mẹo để không lỡ ngày nào"; }
            Bullet { text: "Mỗi lần bạn mở ứng dụng, các lời nhắc sắp tới (tối đa 64) được đặt sẵn với Windows; Windows tự hiện thông báo đúng giờ kể cả khi ứng dụng đã đóng, và bấm vào thông báo sẽ mở đúng hồ sơ. Ứng dụng không chạy ngầm và không tự mở khi bạn đăng nhập Windows, nên thỉnh thoảng hãy mở ứng dụng để lời nhắc được đặt tiếp."; }
            Bullet { text: "Thông báo cần bản cài đặt (.msi) và thông báo của ứng dụng phải đang bật trong Cài đặt Windows › Hệ thống › Thông báo. Tình trạng hiện ở Người thân › Sắp tới, khung “Lời nhắc trên Windows”. Khi bật Không làm phiền, Windows chỉ cất thông báo vào trung tâm thông báo."; }
            Bullet { text: "Mặc định thông báo không ghi tên người (ví dụ “Sắp đến ngày giỗ”), để người khác nhìn màn hình không biết là ai; bật “Hiện tên người trong thông báo” ở cùng khung nếu muốn."; }
            Bullet { text: "Muốn điện thoại cũng nhắc, hãy xuất tệp lịch (.ics) ở mục Sao lưu và mở bằng ứng dụng Lịch của điện thoại."; }
            Bullet { text: "Thỉnh thoảng tạo tệp sao lưu và cất ở nơi an toàn (USB, ổ khác). Tệp này mở được trên máy khác và trên bản web của ứng dụng."; }
        } }
        Panel { VerticalLayout { padding: 18px; spacing: 8px;
            S { text: "Cách tính lịch"; size: 19; }
            Para { text: "Từ năm 1968, âm lịch tính theo múi giờ UTC+7 (giờ Hà Nội)."; }
            Para { text: "Trước năm 1929, âm lịch tính theo giờ địa phương Bắc Kinh; 1929–1967 theo múi giờ UTC+8; từ 1968 theo UTC+7 (chuẩn miền Bắc). Miền Nam dùng UTC+8 đến năm 1975, nên một số tháng 1968–1975 có thể khác lịch miền Nam thời ấy."; }
            Para { text: Data.method-text; }
            Para { text: "Phần xem ngày (sao tốt, sao xấu, việc nên làm và nên tránh, trực, hoàng đạo, hắc đạo) được biên soạn theo quan niệm truyền thống trong sách Ngọc Hạp Thông Thư. Đây là nét văn hóa dân gian, chỉ có giá trị tham khảo; những quyết định quan trọng xin cân nhắc thêm hoàn cảnh thực tế. Điểm số là quy ước của ứng dụng, không có trong sách."; }
            LinkBtn { text: "Nguồn quy tắc xem ngày"; clicked => { Data.about-rules = true; } }
        } }
        Panel { VerticalLayout { padding: 18px; spacing: 8px;
            S { text: "Quyền riêng tư"; size: 19; }
            Para { text: "Ứng dụng không thu thập dữ liệu, không có tài khoản, không quảng cáo và không gửi thông tin đi đâu. Mọi tính toán diễn ra ngay trên máy của bạn. Ứng dụng không tự kết nối mạng và hoạt động hoàn toàn khi không có mạng."; }
            Para { text: "Hồ sơ người thân, ngày giỗ, sinh nhật, ảnh, thông tin báo tử và tệp đính kèm chỉ được lưu trên máy này, trong thư mục %LOCALAPPDATA%\\ClevixLab\\LichVanHoaViet. Ảnh được tự bỏ thông tin vị trí và máy chụp. Tệp sao lưu được mã hóa bằng mật khẩu do bạn đặt; ứng dụng không giữ mật khẩu đó."; }
            Para { text: "Dữ liệu vẫn còn khi bạn đóng ứng dụng hay tắt máy. Cài lại, nâng cấp hay gỡ ứng dụng đều không xóa sổ này. Muốn xóa hẳn: tạo tệp sao lưu nếu cần, gỡ ứng dụng, rồi xóa thư mục trên (thông báo đã đặt sẽ hết khi tới giờ hoặc khi tắt thông báo của ứng dụng trong Cài đặt Windows). Dữ liệu chỉ có trên ổ đĩa của máy này — ổ hỏng hay mất máy là mất dữ liệu, vì vậy hãy sao lưu định kỳ (Người thân › Sao lưu, có cả nút “Mở thư mục dữ liệu”)."; }
            Para { text: "Cỡ chữ và giao diện sáng tối trở về mặc định mỗi lần mở. Ứng dụng ghi một tệp nhỏ chứa ngày bạn bấm \"Để sau\" ở thẻ nhắc cập nhật (trong thư mục %LOCALAPPDATA%\\Clevix). Năm sinh nhập ở mục Chọn ngày tốt chỉ dùng trong lúc tính, không được lưu lại."; }
        } }
        Panel { VerticalLayout { padding: 18px; spacing: 8px;
            S { text: "Nguồn ca dao, tục ngữ"; size: 19; }
            Para { text: Data.attribution; }
            Para { text: Data.cadao-count-text; }
        } }
        Panel { VerticalLayout { padding: 18px; spacing: 8px;
            S { text: "Phông chữ và thư viện"; size: 19; }
            Para { text: "Phông chữ tiêu đề \"LVHV Serif\" là bản rút gọn cho chữ Việt của phông Lora (The Lora Project Authors); phông chữ thường \"LVHV Sans\" là bản rút gọn của phông Be Vietnam Pro (The Be Vietnam Pro Project Authors). Cả hai cấp phép SIL Open Font License 1.1 (tệp OFL.txt đi kèm)."; }
            Para { text: "Giao diện dựng bằng Slint (Made with Slint — https://slint.dev), theo giấy phép Slint Royalty-free 2.0."; }
        } }
        // Chân trang như bản web: logo Clevix cao 44 px, bên cạnh hai dòng "© 2026 Clevix Lab" (serif,
        // © nhỏ 0,82× và nhẹ hơn) và "Phiên bản X.Y.Z" (nhỏ, nhạt).
        footer := Rectangle {
          accessible-role: text;
          accessible-label: "Bản quyền 2026 Clevix Lab, " + Data.version-line;
          HorizontalLayout {
            alignment: center; spacing: 10px; padding-top: 14px; padding-bottom: 6px;
            VerticalLayout { alignment: center; ClevixLogo { } }
            VerticalLayout {
                alignment: center; spacing: 1px;
                HorizontalLayout {
                    alignment: start;
                    S { text: Data.copyright-sign; size: 26 * 0.82; font-weight: 400; color: Theme.ink2; vertical-alignment: center; }
                    S { text: Data.copyright-holder; size: 26; color: Theme.ink; vertical-alignment: center; }
                }
                T { text: Data.version-line; color: Theme.ink3; size: 16; letter-spacing: 0.6px; wrap: no-wrap; }
            }
          }
        }
    }
    if Data.about-rules: VerticalLayout {
        spacing: 14px;
        LinkBtn { text: "Về trang Giới thiệu"; accessible-label: "Về trang Giới thiệu"; clicked => { Data.about-rules = false; } }
        H1 { title: "Nguồn quy tắc"; lead: "Theo Ngọc Hạp Thông Thư; tham khảo. Địa chỉ trang được ghi để đối chiếu; ứng dụng không mở các trang này."; }
        Panel { VerticalLayout { padding: 18px; Blocks { blocks: Data.rule-sources; } } }
        Panel { VerticalLayout { padding: 18px; spacing: 8px;
            S { text: "Nguồn ca dao, tục ngữ (chi tiết)"; size: 19; }
            Blocks { blocks: Data.cadao-sources; }
        } }
    }
}

// Mục chính trên thanh trên (biểu tượng + chữ), mục đang mở nền trắng chữ đỏ như bản web.
component TabBtn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <bool> compact: false;
    callback clicked;
    min-height: 44px;
    min-width: compact ? 52px : tl.preferred-width + 54px;
    border-radius: 22px;
    background: active ? Theme.paper : (ta.has-hover ? #00000010 : transparent);
    drop-shadow-blur: active ? 4px : 0px;
    drop-shadow-color: #0000001f;
    accessible-role: tab;
    accessible-label: text;
    accessible-checked: active;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 8px; alignment: center;
        VerticalLayout { alignment: center; Icon { source: root.icon; tint: root.active ? Theme.red-ink : Theme.ink2; width: 18px; height: 18px; } }
        tl := T { text: root.text; size: 15; font-weight: 600; color: root.active ? Theme.red-ink : Theme.ink2; wrap: no-wrap; vertical-alignment: center; visible: !root.compact; width: root.compact ? 0px : self.preferred-width; }
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Thanh mục chính. Thứ tự: Tờ lịch · Chọn ngày tốt · Đổi ngày · Người thân · Giới thiệu. Số trang giữ như v0.1
// (Giới thiệu = 3); Người thân = 4.
component NavTabs inherits HorizontalLayout {
    in property <int> tab;
    in property <bool> compact: false;
    callback picked(int);
    spacing: 4px;
    for t in [
        { label: "Tờ lịch", icon: @image-url("icons/sheet.svg"), id: 0 },
        { label: "Chọn ngày tốt", icon: @image-url("icons/star.svg"), id: 1 },
        { label: "Đổi ngày", icon: @image-url("icons/swap.svg"), id: 2 },
        { label: "Người thân", icon: @image-url("icons/people.svg"), id: 4 },
        { label: "Giới thiệu", icon: @image-url("icons/info.svg"), id: 3 },
    ]: TabBtn {
        text: t.label; icon: t.icon; active: root.tab == t.id; compact: root.compact;
        clicked => { root.picked(t.id); }
    }
}

// ---------------- Cửa sổ chính ----------------

export component AppWindow inherits Window {
    title: "Lịch và Văn hóa Việt";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1180px;
    preferred-height: 900px;
    min-width: 560px;
    min-height: 600px;
    background: Theme.wall;
    default-font-family: Theme.sans;
    default-font-size: 15px * Theme.scale;

    in-out property <int> tab: 0;
    in-out property <bool> month-open: false;
    in-out property <int> size: 1;
    in-out property <int> theme-mode: 0; // 0 = theo máy, 1 = sáng, 2 = tối
    // Thanh mục xuống hàng riêng khi chữ lớn hoặc cửa sổ hẹp (TKN-W-01).
    // Đo bề rộng thật của thanh mục (theo phông và cỡ chữ đang dùng) bằng một bản ẩn, không đoán bằng ngưỡng cố định.
    out property <bool> two-rows: Theme.scale > 1.01 || measure-nav.preferred-width + measure-title.preferred-width + 300px > root.width;
    callback pick-tab(int);
    pick-tab(id) => { root.tab = id; if (id == 3) { Data.about-rules = false; } if (id == 4) { Data.open-people(); } }
    // Màu nền theo máy lúc mở ứng dụng (đọc một lần trước khi người dùng đổi giao diện).
    property <bool> system-dark: false;
    // Ô nhập/hộp chọn của std-widgets theo màu của ứng dụng (sáng/tối).
    property <bool> td: Theme.dark;
    changed td => { Palette.color-scheme = td ? ColorScheme.dark : ColorScheme.light; }
    init => {
        root.system-dark = Palette.color-scheme == ColorScheme.dark;
        Theme.dark = root.system-dark;
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (root.tab == 0 && !root.month-open) {
                if (e.text == Key.LeftArrow) { Data.step(-1); return accept; }
                if (e.text == Key.RightArrow) { Data.step(1); return accept; }
                if (e.text == Key.Home) { Data.go-today(); return accept; }
            }
            if (e.text == Key.Escape && root.month-open) { root.month-open = false; return accept; }
            reject
        }

        measure-nav := NavTabs { visible: false; x: 0; y: 0; height: 0; tab: -1; }
        measure-title := S { visible: false; x: 0; y: 0; height: 0; text: "Lịch và Văn hóa Việt"; size: 18; wrap: no-wrap; }
        VerticalLayout {
            // Thanh trên. Ở cỡ chữ A+/A++ hoặc khi cửa sổ hẹp, thanh mục xuống hàng riêng dưới tên ứng dụng (TKN-W-01,
            // như PWA 08 §12b); rất hẹp thì chỉ còn biểu tượng (nhãn trợ năng vẫn đủ chữ).
            HorizontalLayout {
                padding: 12px; padding-left: 18px; padding-right: 18px; spacing: 10px;
                padding-bottom: root.two-rows ? 4px : 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout { alignment: center; Image { source: @image-url("../assets/icon.svg"); width: 30px; height: 30px; } }
                    S { text: "Lịch và Văn hóa Việt"; size: 18; vertical-alignment: center; wrap: no-wrap; }
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.two-rows: NavTabs { tab: root.tab; picked(id) => { root.pick-tab(id); } }
                if !root.two-rows: Rectangle { horizontal-stretch: 1; }
                // Cỡ chữ A / A+ / A++
                Rectangle {
                    background: Theme.paper; border-radius: 22px; border-width: 1px; border-color: Theme.outline;
                    height: 44px;
                    HorizontalLayout {
                        padding: 3px; spacing: 2px;
                        for z[i] in ["A", "A+", "A++"]: Rectangle {
                            width: 38px; border-radius: 19px;
                            background: root.size == i + 1 ? Theme.red-deep : (zta.has-hover ? Theme.paper2 : transparent);
                            accessible-role: button;
                            accessible-label: i == 0 ? "Cỡ chữ thường" : (i == 1 ? "Cỡ chữ lớn" : "Cỡ chữ rất lớn");
                            accessible-checked: root.size == i + 1;
                            accessible-action-default => { root.size = i + 1; Theme.scale = i == 0 ? 1.0 : (i == 1 ? 1.15 : 1.32); }
                            Text { text: z; font-family: Theme.serif; font-weight: 600; font-size: (15 + i * 1.5) * 1px; color: root.size == i + 1 ? #ffffff : Theme.ink2; horizontal-alignment: center; vertical-alignment: center; }
                            zta := TouchArea {
                                clicked => { root.size = i + 1; Theme.scale = i == 0 ? 1.0 : (i == 1 ? 1.15 : 1.32); }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
                RoundBtn {
                    icon: @image-url("icons/theme.svg");
                    label: root.theme-mode == 0 ? "Giao diện theo máy. Bấm để chuyển sang tối" : (root.theme-mode == 2 ? "Giao diện tối. Bấm để chuyển sang sáng" : "Giao diện sáng. Bấm để theo máy");
                    clicked => {
                        root.theme-mode = root.theme-mode == 0 ? 2 : (root.theme-mode == 2 ? 1 : 0);
                        Theme.dark = root.theme-mode == 0 ? root.system-dark : root.theme-mode == 2;
                    }
                }
            }
            if root.two-rows: HorizontalLayout {
                padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                alignment: center;
                NavTabs { tab: root.tab; compact: measure-nav.preferred-width + 24px > root.width; picked(id) => { root.pick-tab(id); } }
            }
            // Thẻ nhắc hôm nay trên Tờ lịch (08 §5.5, L7): một thẻ + dòng gộp các lời nhắc khác.
            // Thẳng cột với tờ lịch (rộng 560 px; ở màn rộng bảng tháng chiếm 400 px bên phải) — như TK-31 (b) của PWA.
            if root.tab == 0 && People.sheet-has-card: HorizontalLayout {
                padding-left: 16px; padding-right: root.width >= 1000px ? 400px : 16px; padding-bottom: 6px;
                alignment: center;
                Rectangle {
                    width: min(560px, root.width - (root.width >= 1000px ? 416px : 32px));
                    background: Theme.paper; border-radius: 14px; border-width: 1px; border-color: Theme.outline;
                    accessible-role: text; accessible-label: People.sheet-card.title + ". " + People.sheet-card.sub;
                    Rectangle { x: 0; width: 5px; height: parent.height; background: Theme.red; border-top-left-radius: 14px; border-bottom-left-radius: 14px; }
                    VerticalLayout {
                        padding: 12px; padding-left: 18px; spacing: 6px;
                        T { text: People.sheet-card.title; size: 16; font-weight: 700; }
                        T { text: People.sheet-card.sub; size: 14; color: Theme.ink2; }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            if People.sheet-card.memorial: Btn { text: "Mở trang tưởng niệm"; kind: "primary"; clicked => { root.tab = 4; People.open-memorial(People.sheet-card.pid); } }
                            Btn { text: "Xem"; kind: "outline"; accessible-label: "Xem lời nhắc trên Tờ lịch"; clicked => { root.tab = 4; People.open-person(People.sheet-card.pid); } }
                            Btn { text: "Đã biết"; kind: "outline"; accessible-label: "Đã biết lời nhắc trên Tờ lịch"; clicked => { People.dismiss-sheet-card(); } }
                        }
                        if People.sheet-more > 0: LinkBtn {
                            text: "Còn " + People.sheet-more + " lời nhắc khác hôm nay — Xem"; size: 14;
                            clicked => { root.tab = 4; People.go("sap-toi"); }
                        }
                    }
                }
            }
            if root.tab == 0 && Data.remind: HorizontalLayout {
                padding-left: 16px; padding-right: 16px; padding-bottom: 6px;
                alignment: center;
                Rectangle {
                    max-width: 720px;
                    horizontal-stretch: 1;
                    background: Theme.gold-tint;
                    border-radius: 14px;
                    HorizontalLayout {
                        padding: 10px; spacing: 10px;
                        T { text: "Phiên bản này đã phát hành hơn 2 tháng. Hãy kiểm tra cập nhật để có dữ liệu và tính năng mới nhất."; size: 14; vertical-alignment: center; horizontal-stretch: 1; accessible-role: text; }
                        Btn { text: "Kiểm tra cập nhật"; kind: "primary"; clicked => { Data.check-update(); } }
                        Btn { text: "Để sau"; clicked => { Data.remind-later(); } }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.tab == 0: HorizontalLayout {
                    SheetPage {
                        s: Data.sheet;
                        open-month => { Data.open-month(); root.month-open = true; }
                        day-swipe(n) => { Data.step(n); }
                    }
                    // Màn rộng: bảng tháng đặt cạnh tờ lịch (giống bản web ở 1280 px).
                    if root.width >= 1000px: VerticalLayout {
                        width: 400px; padding: 16px; padding-left: 0px; padding-top: 60px; alignment: start;
                        Card {
                            VerticalLayout { padding: 16px;
                                MonthGrid {
                                    cells: Data.cells; month: Data.view-month; year-text: Data.view-year;
                                    can-prev: Data.view-can-prev; can-next: Data.view-can-next;
                                    shift(n) => { Data.month-shift(n); }
                                    set-month(m) => { Data.month-set(m); }
                                    set-year(t) => { Data.year-set(t); }
                                    pick(d) => { Data.month-pick(d); }
                                }
                            }
                        }
                    }
                }
                if root.tab == 1: GoodDaysPage { }
                if root.tab == 2: ConvertPage { }
                if root.tab == 3: AboutPage { }
                if root.tab == 4: PeopleView { }

                // Hộp thoại "Chọn ngày"
                if root.month-open: Rectangle {
                    background: #00000066;
                    TouchArea { clicked => { root.month-open = false; } }
                    Card {
                        width: min(parent.width - 32px, 480px);
                        height: min(parent.height - 32px, self.preferred-height);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 20px;
                        TouchArea { }
                        VerticalLayout {
                            padding: 20px; spacing: 12px;
                            HorizontalLayout {
                                S { text: "Chọn ngày"; size: 24; vertical-alignment: center; horizontal-stretch: 1; }
                                RoundBtn { icon: @image-url("icons/close.svg"); label: "Đóng"; clicked => { root.month-open = false; } }
                            }
                            MonthGrid {
                                cells: Data.cells; month: Data.view-month; year-text: Data.view-year;
                                can-prev: Data.view-can-prev; can-next: Data.view-can-next;
                                shift(n) => { Data.month-shift(n); }
                                set-month(m) => { Data.month-set(m); }
                                set-year(t) => { Data.year-set(t); }
                                pick(d) => { Data.month-pick(d); root.month-open = false; }
                            }
                            HorizontalLayout { alignment: center;
                                Btn { text: "Về hôm nay"; kind: "primary"; width: 180px; clicked => { Data.go-today(); root.month-open = false; } }
                            }
                        }
                    }
                }
            }
        }
    }
}

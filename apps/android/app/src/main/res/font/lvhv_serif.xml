<?xml version="1.0" encoding="utf-8"?>
<!-- "LVHV Serif": bản rút gọn (Latin + tiếng Việt) của Lora, SIL OFL 1.1. Không mang tên
     "Lora" (Reserved Font Name) vì là bản đã sửa đổi. Giấy phép: assets/OFL.txt -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/lvhv_serif_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/lvhv_serif_semibold" android:fontStyle="normal" android:fontWeight="600" />
    <font android:font="@font/lvhv_serif_bold" android:fontStyle="normal" android:fontWeight="700" />
</font-family>

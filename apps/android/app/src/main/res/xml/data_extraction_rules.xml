<?xml version="1.0" encoding="utf-8"?>
<!-- S5: không sao lưu lên đám mây, không chuyển sang máy mới — gồm cả sổ người thân (files/lvhv.sqlite,
     files/photos/). Người dùng tự sao lưu bằng tệp .lvhv đã mã hóa (Người thân › Sao lưu). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
